# MongoDB Atlas (Studiofex)
# Path segment is the Atlas database name. Keep `graafex` until that DB is renamed/migrated.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/graafex?retryWrites=true&w=majority
# On Vercel, IPv4 is forced automatically (Node 24 + Atlas TLS). Override:
# MONGODB_FORCE_IPV4=1
# MONGODB_FORCE_IPV4=0

# Temporary — only for `npm run import:neon` (Neon Postgres → Mongo)
# DATABASE_URL=postgresql://...

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Optional: treat these emails as admin (comma-separated)
# ADMIN_EMAIL_ALLOWLIST=you@example.com

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# S3_API_ENDPOINT=
